{
  "manifest_version": 3,
  "name": "whatstauts",
  "description": "Shows the game you're playing in your WhatsApp About.",
  "version": "1.0",
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["nativeMessaging"],
  "content_scripts": [
    { "matches": ["https://web.whatsapp.com/*"], "js": ["page.js", "ui.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://web.whatsapp.com/*"], "js": ["bridge.js"], "run_at": "document_idle" }
  ]
}
